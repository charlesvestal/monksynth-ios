/* MonkSynth — 日本語文字列。キーの構成は en.lproj / ko.lproj と完全に一致させること。 */

/* XY 演奏パッドのアクセシビリティラベル。 */
"pad.label" = "演奏パッド。左右にドラッグで音程、上下にドラッグで母音を操作します。";
"pad.hint" = "触れて歌おう";

/* キャラクターセレクターの ‹ 矢印ボタン（前のキャラクターに切り替える）の
   アクセシビリティラベル。 */
"character.previous" = "前のキャラクター";

/* キャラクターセレクターの › 矢印ボタン（次のキャラクターに切り替える）の
   アクセシビリティラベル。 */
"character.next" = "次のキャラクター";

/* キャラクターセレクターの名前／ドロップダウンの可変コントロールに付ける
   アクセシビリティラベル（アクセシビリティ値には現在のキャラクター名が入ります。
   例: "Monk"、"Fish" — CharacterRegistry 参照。ローカライズはしていません）。 */
"characterSelector.label" = "キャラクター";

/* キャラクターセレクターの名前／ドロップダウンの可変コントロールの
   アクセシビリティヒント。上下にスワイプするとキャラクターが切り替わり、
   ダブルタップすると一覧が開くことを説明する。 */
"characterSelector.hint" = "上下にスワイプするとキャラクターが変わります。ダブルタップするとリストから選択できます。";

/* キャラクタードロップダウン（キャラクターセレクターの ⌄ で開く）：タイトル。 */
"characterPicker.title" = "キャラクターを選択";

/* キャラクタードロップダウン：ユーザーが保存したキャラクターの上に表示するセクション見出し
   （組み込みキャラクターはこの上に見出しなしで並ぶ）。 */
"characterPicker.saved" = "保存済み";

/* About 画面：タイトル。 */
"about.title" = "MonkSynth";

/* About 画面：楽器の簡単な説明。 */
"about.tagline" = "フォルマント波形関数合成を用いたモノフォニック・ボーカルシンセサイザーです。";

/* About 画面：原作者への明記されたクレジット。 */
"about.credit" = "Jonathan Taylor 氏の MonkSynth をベースにしています。";

/* About 画面：iOS 移植版のクレジット。上の about.credit（Jonathan Taylor 氏が
   MonkSynth を作成）とは別の事実であり、Charles Vestal 氏が iOS に移植した
   ことを示す。一文にまとめず、あえて分けている。 */
"about.portCredit" = "iOS 版は Charles Vestal 氏によって移植されました。";

/* About 画面：iOS 移植版の作者のサイト（https://charles.pizza）へのボタン／
   リンク。上の about.portCredit と対になる。 */
"about.portLink" = "charles.pizza";

/* About 画面：MIT ライセンス表記（必須）。 */
"about.license" = "MIT ライセンス。Copyright (c) 2026 Jonathan Taylor.";

/* About 画面：オマージュ表明と寄付のお願い。アプリ内で唯一許可された
   「Delay Lama」への言及（史実としての系譜）もここに含まれる —
   単独の系譜行としてではなく、この一文に統合することで、寄付のお願いを
   加えても言及回数を1回に保っている。アプリ名・サブタイトル・キーワードには
   一切使用しない。
   LocalizationTests.testDelayLamaAppearsExactlyOnceInEnglish が
   （英語版のテキストを基準に）これを検証する。 */
"about.donation" = "MonkSynth は、AudioNerdz による名作 VST プラグイン Delay Lama (2002) へのオマージュとして、完全に無料で提供しています。私たちが制作を楽しんだのと同じくらい MonkSynth を楽しんでいただけたなら、www.savetibet.org への寄付をお願いいたします。";

/* About 画面：寄付先サイト（https://www.savetibet.org）へのボタン／リンク。
   上の about.donation と対になる。 */
"about.donationLink" = "www.savetibet.org";

/* About 画面：アップストリームのソースコードへのリンク。 */
"about.source" = "ソースコード";

/* About 画面：Bluetooth MIDI 機器選択画面を開くボタン（ホストアプリのみ）。 */
"about.bluetooth" = "Bluetooth MIDI を接続";

/* About 画面：閉じるボタン。 */
"about.close" = "閉じる";

/* About 画面：他のアプリ一覧画面を開くボタン／リンク。 */
"about.moreApps" = "その他のアプリ";

/* ヘッダーの ⓘ ボタン（About 画面を開く）のアクセシビリティラベル。 */
"about.info" = "MonkSynth について";

/* 他のアプリ一覧画面：タイトル。 */
"moreapps.title" = "その他のアプリ";

/* 他のアプリ一覧画面：開発者のアプリカタログを読み込み中に表示。 */
"moreapps.loading" = "アプリを読み込み中…";

/* 他のアプリ一覧画面：カタログを取得できず、以前起動時のキャッシュもない場合に表示。
   何も表示しない空のパネルではなく、正直な失敗メッセージを示す。 */
"moreapps.empty" = "他のアプリを読み込めませんでした。接続を確認するか、下の App Store リンクをお試しください。";

/* 他のアプリ一覧画面：開発者の App Store ページ全体へのフッターリンク。 */
"moreapps.viewAll" = "App Store で全アプリを見る";

/* スタンドアロンエンジンの起動に失敗した際のアラートタイトル。 */
"audio.start.failed.title" = "オーディオを開始できませんでした";

/* スタンドアロンエンジンがオーディオフォーマットを作成できなかった場合のエラー説明。 */
"audio.error.format" = "スタンドアロンエンジン用のオーディオフォーマットを作成できませんでした。";

/* オーディオ開始失敗アラートの汎用的な閉じるボタン。 */
"ok" = "OK";

/* キャラクタードロップダウン：新規キャラクター名入力欄のプレースホルダーテキスト。 */
"presets.namePlaceholder" = "プリセット名";

/* キャラクタードロップダウン：現在のパッチ（サウンドと見た目）を新しい保存済みキャラクターとして保存するボタン。名前入力欄の横に固定の狭い幅で配置されるため短くしてある。 */
"presets.save" = "保存";

/* キャラクタードロップダウン：名前を空欄のまま保存しようとしたときに表示。 */
"presets.error.emptyName" = "プリセットの名前を入力してください。";

/* キャラクタードロップダウン：既に保存済みの別のキャラクターと同じ名前で保存しようとしたときに表示。 */
"presets.error.duplicateName" = "その名前のプリセットは既に存在します。";

/* キャラクタードロップダウン：その他の理由で保存に失敗したときに表示。 */
"presets.error.saveFailed" = "プリセットを保存できませんでした。";

/* キャラクタードロップダウン：現在のホストがユーザープリセットの保存に対応していない場合、保存用コントロールの代わりに表示。 */
"presets.unsupportedHost" = "このアプリではここでプリセットを保存できません。";

